# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Windows batch files require CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# PowerShell scripts can use LF
*.ps1 text eol=lf

# Binary files
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.exe binary
*.dll binary
*.pyd binary
*.onnx binary
